// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -------------------------------------
// Core Auth & Users
// -------------------------------------

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  volunteer Volunteer?
  student   Student?
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions String[]
  users       User[]
}

// -------------------------------------
// Volunteers
// -------------------------------------

model Volunteer {
  id             String                 @id @default(uuid())
  userId         String                 @unique
  user           User                   @relation(fields: [userId], references: [id])
  skills         String[]
  status         String                 @default("ACTIVE") // ACTIVE, INACTIVE
  applications   VolunteerApplication[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model VolunteerApplication {
  id             String    @id @default(uuid())
  volunteerId    String
  volunteer      Volunteer @relation(fields: [volunteerId], references: [id])
  status         String    @default("PENDING") // PENDING, APPROVED, REJECTED
  experienceDesc String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// -------------------------------------
// Schools & Outreach
// -------------------------------------

model School {
  id             String               @id @default(uuid())
  name           String
  address        String
  contactPerson  String
  contactEmail   String
  contactPhone   String
  visitRequests  SchoolVisitRequest[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model SchoolVisitRequest {
  id             String   @id @default(uuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id])
  requestedDate  DateTime
  status         String   @default("PENDING")
  purpose        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model OutreachRequest {
  id             String   @id @default(uuid())
  institution    String
  contactName    String
  contactEmail   String
  programs       String[]
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PartnerRequest {
  id                  String   @id @default(uuid())
  name                String
  email               String
  phone               String
  organization        String?
  website             String?
  linkedin            String?
  organizationType    String
  partnershipInterest String
  collaborationMode   String?
  areasOfInterest     String[]
  message             String?
  meetingMode         String?
  meetingDate         DateTime?
  documentUrl         String?
  status              String   @default("PENDING") // PENDING, REVIEWED, ACCEPTED, REJECTED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// -------------------------------------
// Students & Courses
// -------------------------------------

model Student {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id])
  schoolName     String?
  courses        Course[]  @relation("StudentCourses")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Course {
  id             String    @id @default(uuid())
  title          String
  description    String
  students       Student[] @relation("StudentCourses")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// -------------------------------------
// Events & Activities
// -------------------------------------

model Event {
  id          String   @id @default(uuid())
  title       String
  description String   @default("")
  date        DateTime
  location    String   @default("")
  link        String?  // Deep-link for the arrow button on the card
  color       String?  // Tailwind class e.g. 'bg-blue-400'
  photos      String[] @default([])
  eventType   String   @default("AUTO") // MANUAL, AUTO
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -------------------------------------
// Certificates
// -------------------------------------

model Certificate {
  id             String    @id @default(uuid())
  recipientEmail String
  recipientName  String
  type           String    // VOLUNTEER, COURSE, EVENT
  pdfUrl         String?
  issuedAt       DateTime  @default(now())
}

// -------------------------------------
// Donations
// -------------------------------------

model Donation {
  id             String    @id @default(uuid())
  donorName      String
  donorEmail     String
  donorPhone     String?
  donorPan       String?
  donorAddress   String?
  amount         Float
  currency       String    @default("INR")
  status         String    @default("PENDING") // PENDING, COMPLETED, FAILED
  transactionId  String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// -------------------------------------
// Notifications
// -------------------------------------

model Notification {
  id             String    @id @default(uuid())
  userId         String?   // Null if system-wide
  title          String
  message        String
  type           String    // EMAIL, SMS, PUSH, IN_APP
  status         String    @default("PENDING") // PENDING, SENT, FAILED
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// -------------------------------------
// Contact Messages
// -------------------------------------

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  role      String
  message   String
  status    String   @default("PENDING") // PENDING, REVIEWED, REPLIED
  createdAt DateTime @default(now())
}

model NotificationRecipient {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}

// -------------------------------------
// System Settings
// -------------------------------------

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// -------------------------------------
// Team Leads & Activity Logs
// -------------------------------------

model TeamLead {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  phone          String
  position       String
  loginEmail     String?  @unique
  password       String?
  credStatus     String   @default("Pending Approval") // Approved, Pending Approval, Rejected
  msgAccess      String   @default("No Access") // Can View & Reply, Can View Only, No Access, Request Pending
  status         String   @default("Junior Lead") // Junior Lead, Team Lead, Sr. Team Lead
  avatar         String?  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(uuid())
  action    String
  leadName  String
  details   String
  color     String   @default("blue")
  icon      String   @default("Info")
  createdAt DateTime @default(now())
}

