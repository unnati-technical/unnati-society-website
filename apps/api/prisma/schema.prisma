generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  firstName String
  lastName  String
  roleId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  student   Student?
  role      Role       @relation(fields: [roleId], references: [id])
  volunteer Volunteer?
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions String[]
  users       User[]
}

model Volunteer {
  id           String                 @id @default(uuid())
  userId       String                 @unique
  skills       String[]
  status       String                 @default("ACTIVE")
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  user         User                   @relation(fields: [userId], references: [id])
  applications VolunteerApplication[]
}

model VolunteerApplication {
  id                String    @id @default(uuid())
  volunteerId       String
  status            String    @default("PENDING")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  address           String    @default("")
  availability      String    @default("")
  college           String    @default("")
  currentYear       String    @default("")
  dob               String    @default("")
  education         String    @default("")
  gender            String    @default("")
  howDidYouHear     String    @default("")
  linkedinUrl       String?
  phone             String    @default("")
  preferredLocation String    @default("")
  preferredMode     String    @default("Online")
  program           String    @default("General")
  roleAppliedFor    String    @default("Volunteer")
  whyVolunteer      String    @default("")
  careerGoals       String    @default("")
  department        String    @default("")
  emergencyName     String    @default("")
  emergencyPhone    String    @default("")
  experienceDesc    String    @default("")
  hasNgoExperience  String    @default("no")
  hoursPerWeek      String    @default("")
  ngoName           String    @default("")
  portfolioUrl      String?
  resumeUrl         String?
  startDate         String    @default("")
  interests         String[]  @default([])
  skills            String[]  @default([])
  volunteer         Volunteer @relation(fields: [volunteerId], references: [id])
}

model School {
  id              String   @id @default(uuid())
  name            String
  address         String
  contactPerson   String
  contactEmail    String
  contactPhone    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  about           String   @default("")
  affiliation     String   @default("BSEB")
  city            String   @default("")
  district        String   @default("")
  establishedYear String   @default("")
  focusAreas      String[] @default([])
  grades          String   @default("")
  logo            String?
  programs        String[] @default([])
  schoolCategory  String   @default("Secondary")
  schoolType      String   @default("Government")
  status          String   @default("Active")
  studentsCount   Int      @default(0)
  teachersCount   Int      @default(0)
}

model Partner {
  id            String   @id @default(uuid())
  logo          String?
  organization  String
  type          String   @default("NGO")
  contactPerson String
  email         String
  phone         String
  focusArea     String   @default("")
  status        String   @default("Active")
  since         DateTime @default(now())
  website       String?
  city          String   @default("")
  address       String   @default("")
  about         String   @default("")
  highlights    String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CampusVisitRequest {
  id              String   @id @default(uuid())
  institutionName String
  institutionType String?
  board           String?
  website         String?
  state           String?
  district        String?
  city            String?
  address         String?
  studentsCount   String?
  teachersCount   String?
  classes         String[] @default([])
  purposes        String[] @default([])
  activities      String[] @default([])
  prefDate        String?
  altDate         String?
  prefTime        String?
  coordinatorName String
  designation     String?
  email           String
  phone           String?
  whatsapp        String?
  notes           String?
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model OutreachRequest {
  id                   String   @id @default(uuid())
  programs             String[] @default([])
  status               String   @default("PENDING")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  address              String?
  altDate              String?
  availability         String?
  board                String?
  city                 String?
  coordinatorName      String
  designation          String?
  district             String?
  duration             String?
  email                String
  expectedParticipants String?
  institutionName      String
  institutionType      String?
  notes                String?
  phone                String?
  prefDate             String?
  preferredMode        String?
  specialReqs          String?
  state                String?
  studentsCount        String?
  targetAudience       String[] @default([])
  website              String?
  whatsapp             String?
}

model PartnerRequest {
  id                  String    @id @default(uuid())
  name                String
  email               String
  phone               String
  organization        String?
  website             String?
  linkedin            String?
  organizationType    String
  partnershipInterest String
  collaborationMode   String?
  areasOfInterest     String[]
  message             String?
  meetingMode         String?
  meetingDate         DateTime?
  documentUrl         String?
  status              String    @default("PENDING")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  adminNotes          String?
}

model Student {
  id         String   @id @default(uuid())
  userId     String   @unique
  schoolName String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])
  courses    Course[] @relation("StudentCourses")
}

model Course {
  id          String    @id @default(uuid())
  title       String
  description String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  students    Student[] @relation("StudentCourses")
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String   @default("")
  date        DateTime
  location    String   @default("")
  link        String?
  color       String?
  photos      String[] @default([])
  eventType   String   @default("AUTO")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Certificate {
  id               String   @id @default(uuid())
  referenceNo      String   @unique
  recipientName    String
  rollNo           String?
  team             String?
  batch            String?
  appreciationType String
  bodyText         String?
  pdfUrl           String?
  issuedAt         DateTime @default(now())
}

model AdminUser {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String   @default("Admin")
  role      String   @default("Admin")
  createdAt DateTime @default(now())
}

model Donation {
  id            String   @id @default(uuid())
  donorName     String
  donorEmail    String
  donorPhone    String?
  donorPan      String?
  donorAddress  String?
  amount        Float
  currency      String   @default("INR")
  status        String   @default("PENDING")
  transactionId String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  title     String
  message   String
  type      String
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  role      String
  message   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model NotificationRecipient {
  id         String   @id @default(uuid())
  email      String   @unique
  name       String
  createdAt  DateTime @default(now())
  categories String[] @default([])
  department String   @default("General")
  phone      String?
  status     String   @default("Active")
  updatedAt  DateTime @updatedAt
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model TeamLead {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  phone      String
  position   String
  loginEmail String?  @unique
  password   String?
  credStatus String   @default("Pending Approval")
  msgAccess  String   @default("No Access")
  status     String   @default("Junior Lead")
  avatar     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(uuid())
  action    String
  leadName  String
  details   String
  color     String   @default("blue")
  icon      String   @default("Info")
  createdAt DateTime @default(now())
}

model LeadershipYear {
  id        String              @id @default(uuid())
  year      String              @unique
  isActive  Boolean             @default(false)
  createdAt DateTime            @default(now())
  sections  LeadershipSection[]
}

model LeadershipSection {
  id           String             @id @default(uuid())
  yearId       String
  name         String
  slug         String
  badgeColor   String             @default("blue")
  displayOrder Int                @default(0)
  isVisible    Boolean            @default(true)
  members      LeadershipMember[]
  year         LeadershipYear     @relation(fields: [yearId], references: [id], onDelete: Cascade)
}

model LeadershipMember {
  id           String            @id @default(uuid())
  sectionId    String
  fullName     String
  designation  String
  department   String?           @default("")
  bio          String?
  profileImage String?
  linkedin     String?
  instagram    String?
  email        String?
  displayOrder Int               @default(0)
  isPublished  Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  section      LeadershipSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  userEmail    String?
  action       String
  entity       String
  entityId     String?
  previousData String?
  updatedData  String?
  ipAddress    String?
  createdAt    DateTime @default(now())
}

model HomeMedia {
  id           String   @id @default(uuid())
  type         String   // "VIDEO" or "PHOTO"
  url          String
  title        String?
  subtitle     String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VolunteerLeaderboard {
  id        String   @id @default(uuid())
  name      String
  role      String
  avatar    String?  // ImageKit image URL or ID
  workshops Int      @default(0)
  hours     Int      @default(0)
  linkedin  String?
  instagram String?
  month     String   // Format: "YYYY-MM" (e.g. "2026-08") or "ALL_TIME"
  rank      Int      // 1, 2, or 3
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month, rank])
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ─── RAG Knowledge Base ───────────────────────────────────────────────────────

model KnowledgeDocument {
  id        String           @id @default(uuid())
  title     String
  type      String           @default("markdown") // markdown | faq | policy | program
  source    String           // filename or URL
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  chunks    KnowledgeChunk[]
}

model KnowledgeChunk {
  id         String            @id @default(uuid())
  documentId String
  content    String
  embedding  Unsupported("vector(768)")?
  metadata   String            @default("{}") // JSON string: {page, section, language}
  chunkIndex Int               @default(0)
  createdAt  DateTime          @default(now())
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

// ─── Chat Sessions ────────────────────────────────────────────────────────────

model ChatSession {
  id        String   @id @default(uuid())
  userId    String?  // Firebase UID if authenticated
  messages  String   @default("[]") // JSON array of {role, content, timestamp}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
}
