// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -------------------------------------
// Core Auth & Users
// -------------------------------------

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  volunteer Volunteer?
  student   Student?
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions String[]
  users       User[]
}

// -------------------------------------
// Volunteers
// -------------------------------------

model Volunteer {
  id             String                 @id @default(uuid())
  userId         String                 @unique
  user           User                   @relation(fields: [userId], references: [id])
  skills         String[]
  status         String                 @default("ACTIVE") // ACTIVE, INACTIVE
  applications   VolunteerApplication[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model VolunteerApplication {
  id                String    @id @default(uuid())
  volunteerId       String
  volunteer         Volunteer @relation(fields: [volunteerId], references: [id])
  status            String    @default("PENDING") // PENDING, APPROVED, REJECTED, UNDER REVIEW
  
  // Application details
  program           String    @default("General")
  roleAppliedFor    String    @default("Volunteer")
  phone             String    @default("")
  dob               String    @default("")
  gender            String    @default("")
  education         String    @default("")
  college           String    @default("")
  currentYear       String    @default("")
  availability      String    @default("")
  preferredMode     String    @default("Online")
  preferredLocation String    @default("")
  address           String    @default("")
  whyVolunteer      String    @default("")
  linkedinUrl       String?
  portfolioUrl      String?
  resumeUrl         String?
  howDidYouHear     String    @default("")
  
  // New captured fields
  department        String    @default("")
  hoursPerWeek      String    @default("")
  hasNgoExperience  String    @default("no")
  ngoName           String    @default("")
  experienceDesc    String    @default("")
  emergencyName     String    @default("")
  emergencyPhone    String    @default("")
  careerGoals       String    @default("")
  startDate         String    @default("")
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// -------------------------------------
// Schools & Outreach
// -------------------------------------

model School {
  id             String               @id @default(uuid())
  logo           String?
  name           String
  city           String               @default("")
  district       String               @default("")
  address        String
  contactPerson  String
  contactEmail   String
  contactPhone   String
  programs       String[]             @default([])
  status         String               @default("Active")
  studentsCount  Int                  @default(0)
  
  // Detailed info
  schoolType     String               @default("Government")
  schoolCategory String               @default("Secondary")
  affiliation    String               @default("BSEB")
  establishedYear String              @default("")
  grades         String               @default("")
  teachersCount  Int                  @default(0)
  about          String               @default("")
  focusAreas     String[]             @default([])

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model Partner {
  id                  String   @id @default(uuid())
  logo                String?
  organization        String
  type                String   @default("NGO")
  contactPerson       String
  email               String
  phone               String
  focusArea           String   @default("")
  status              String   @default("Active")
  since               DateTime @default(now())
  website             String?
  city                String   @default("")
  address             String   @default("")
  about               String   @default("")
  highlights          String[] @default([])
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model CampusVisitRequest {
  id               String   @id @default(uuid())
  institutionName  String
  institutionType  String?
  board            String?
  website          String?
  state            String?
  district         String?
  city             String?
  address          String?
  studentsCount    String?
  teachersCount    String?
  classes          String[] @default([])
  purposes         String[] @default([])
  activities       String[] @default([])
  prefDate         String?
  altDate          String?
  prefTime         String?
  coordinatorName  String
  designation      String?
  email            String
  phone            String?
  whatsapp         String?
  notes            String?
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model OutreachRequest {
  id                   String   @id @default(uuid())
  institutionName      String
  institutionType      String?
  board                String?
  studentsCount        String?
  website              String?
  state                String?
  district             String?
  city                 String?
  address              String?
  programs             String[] @default([])
  targetAudience       String[] @default([])
  expectedParticipants String?
  preferredMode        String?
  prefDate             String?
  altDate              String?
  duration             String?
  coordinatorName      String
  designation          String?
  phone                String?
  whatsapp             String?
  email                String
  availability         String?
  notes                String?
  specialReqs          String?
  status               String   @default("PENDING")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model PartnerRequest {
  id                  String   @id @default(uuid())
  name                String
  email               String
  phone               String
  organization        String?
  website             String?
  linkedin            String?
  organizationType    String
  partnershipInterest String
  collaborationMode   String?
  areasOfInterest     String[]
  message             String?
  meetingMode         String?
  meetingDate         DateTime?
  documentUrl         String?
  adminNotes          String?
  status              String   @default("PENDING") // PENDING, REVIEWED, ACCEPTED, REJECTED, HOLD, NEED_MORE_INFO
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// -------------------------------------
// Students & Courses
// -------------------------------------

model Student {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id])
  schoolName     String?
  courses        Course[]  @relation("StudentCourses")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Course {
  id             String    @id @default(uuid())
  title          String
  description    String
  students       Student[] @relation("StudentCourses")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// -------------------------------------
// Events & Activities
// -------------------------------------

model Event {
  id          String   @id @default(uuid())
  title       String
  description String   @default("")
  date        DateTime
  location    String   @default("")
  link        String?  // Deep-link for the arrow button on the card
  color       String?  // Tailwind class e.g. 'bg-blue-400'
  photos      String[] @default([])
  eventType   String   @default("AUTO") // MANUAL, AUTO
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -------------------------------------
// Certificates
// -------------------------------------

model Certificate {
  id             String    @id @default(uuid())
  recipientEmail String
  recipientName  String
  type           String    // VOLUNTEER, COURSE, EVENT
  pdfUrl         String?
  issuedAt       DateTime  @default(now())
}

// -------------------------------------
// Donations
// -------------------------------------

model Donation {
  id             String    @id @default(uuid())
  donorName      String
  donorEmail     String
  donorPhone     String?
  donorPan       String?
  donorAddress   String?
  amount         Float
  currency       String    @default("INR")
  status         String    @default("PENDING") // PENDING, COMPLETED, FAILED
  transactionId  String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// -------------------------------------
// Notifications
// -------------------------------------

model Notification {
  id             String    @id @default(uuid())
  userId         String?   // Null if system-wide
  title          String
  message        String
  type           String    // EMAIL, SMS, PUSH, IN_APP
  status         String    @default("PENDING") // PENDING, SENT, FAILED
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// -------------------------------------
// Contact Messages
// -------------------------------------

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  role      String
  message   String
  status    String   @default("PENDING") // PENDING, REVIEWED, REPLIED
  createdAt DateTime @default(now())
}

model NotificationRecipient {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}

// -------------------------------------
// System Settings
// -------------------------------------

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// -------------------------------------
// Team Leads & Activity Logs
// -------------------------------------

model TeamLead {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  phone          String
  position       String
  loginEmail     String?  @unique
  password       String?
  credStatus     String   @default("Pending Approval") // Approved, Pending Approval, Rejected
  msgAccess      String   @default("No Access") // Can View & Reply, Can View Only, No Access, Request Pending
  status         String   @default("Junior Lead") // Junior Lead, Team Lead, Sr. Team Lead
  avatar         String?  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(uuid())
  action    String
  leadName  String
  details   String
  color     String   @default("blue")
  icon      String   @default("Info")
  createdAt DateTime @default(now())
}

