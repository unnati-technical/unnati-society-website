# ─── Unnati Society — Environment Variables Example ───────────────────────────
# Copy this file to .env and fill in real values. Never commit .env to git.

# ── API (apps/api) ─────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Firebase Admin (service account JSON as string)
FIREBASE_SERVICE_ACCOUNT=

# JWT
JWT_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_in_production

# ── Web / Admin / Portals (Vite apps) ──────────────────────────────────────────
VITE_API_URL=http://localhost:4000/api

# ── Email (Nodemailer) ─────────────────────────────────────────────────────────
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=

# ── Cloudinary ─────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
