{
  "name": "unnati-society",
  "private": true,
  "version": "1.0.0",
  "description": "Unnati Society — NGO Monorepo powering the public website, admin dashboard, volunteer portal, student portal, and API.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "dev:web": "turbo dev --filter=@unnati/web",
    "dev:admin": "turbo dev --filter=@unnati/admin",
    "dev:api": "turbo dev --filter=@unnati/api",
    "build:web": "turbo build --filter=@unnati/web",
    "clean": "turbo clean && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.22.0",
  "pnpm": {
    "allowedBuildScripts": ["esbuild"]
  }
}
